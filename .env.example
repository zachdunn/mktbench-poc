# Copy to .env (gitignored) and fill in. Existing shell env vars take precedence.

# Provider: "anthropic" or "openrouter". Unset = auto-detect from whichever key exists
# (Anthropic wins if both are set).
#MB_PROVIDER=openrouter

# One of these is required for live judge/agent runs; with neither, the harness runs offline.
#ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Model overrides. PoC defaults are small/cheap: claude-haiku-4-5 (Anthropic) or
# deepseek/deepseek-v4-flash (OpenRouter — any OpenRouter model id works).
#MB_JUDGE_MODEL=deepseek/deepseek-v4-flash
#MB_AGENT_MODEL=deepseek/deepseek-v4-flash

# Force offline grading (keyword-rule judges, regex-only extraction) even with a key set.
#MB_OFFLINE=1
